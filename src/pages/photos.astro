---
import Base from '../layouts/Base.astro';
import PhotoSlideshow from '../components/PhotoSlideshow.astro';
import { getPhotoPosts } from '../lib/posts';

// /photos opens the newest photo post; the menu above it lists the rest.
const posts = await getPhotoPosts();
const latest = posts[0];
---

<Base title="Photos" description={latest?.data.description ?? 'Photos.'} wide>
  {
    latest ? (
      <PhotoSlideshow post={latest} posts={posts} />
    ) : (
      <div class="empty-state">
        <p>No photos yet. Add a note to the Photos folder in Obsidian and embed some photos in it.</p>
      </div>
    )
  }
</Base>
