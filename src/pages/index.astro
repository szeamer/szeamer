---
import Base from '../layouts/Base.astro';
import PostTimeline from '../components/PostTimeline.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getEntry, render } from 'astro:content';
import { navLinks, site } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
// The about-me text is the body of Home.md in Obsidian.
const home = await getEntry('pages', 'home');
const About = home ? (await render(home)).Content : null;
---

<Base>
  <section class="section">
    <h1 class="page-title">{site.title}</h1>
    <p class="page-intro">{site.tagline}</p>
    {About && <About />}
  </section>

  <section class="section">
    <h2 class="section__title">Writing</h2>
    <PostTimeline posts={posts} />
  </section>

  <section class="section">
    <h2 class="section__title">Elsewhere on this site</h2>
    <ul class="link-list">
      {
        navLinks.map((link) => (
          <li class="link-list__item">
            <a href={link.href}>{link.label}</a>
            {link.blurb && <span class="link-list__blurb">{link.blurb}</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section__title">Elsewhere on the internet</h2>
    <SocialLinks />
  </section>
</Base>
