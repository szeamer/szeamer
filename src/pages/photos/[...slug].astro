---
import Base from '../../layouts/Base.astro';
import PhotoSlideshow from '../../components/PhotoSlideshow.astro';
import { getPhotoPosts } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getPhotoPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
---

<Base title={post.data.title} description={post.data.description} wide>
  <PhotoSlideshow post={post} posts={posts} />
</Base>
