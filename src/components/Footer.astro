---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

interface Props {
  shell: string;
}

const { shell } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class={shell}>
    <SocialLinks inline />
    <p>&copy; {year} {site.title}</p>
  </div>
</footer>
