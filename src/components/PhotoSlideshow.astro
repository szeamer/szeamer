---
/**
 * A photo post as a slideshow: one photo per screen, click the right/left half
 * (or use the arrow keys, or swipe) to move, with a line underneath for the post
 * title, the photo's caption, its camera details and a counter. Above it, a menu
 * of all photo posts.
 *
 * If the post has an introduction (text above the first photo, or its
 * description), it opens as an overlay in front of the first photo, with that
 * photo's line already showing underneath. The first "next" lifts the overlay
 * away; going back from the first photo brings it down again.
 *
 * Without JavaScript the slides still scroll sideways (and the intro isn't shown).
 */
import { Image } from 'astro:assets';
import type { PhotoPost } from '../lib/posts';
import { introFor, slidesFor } from '../lib/photo-slides';

interface Props {
  post: PhotoPost;
  posts: PhotoPost[];
}

const { post, posts } = Astro.props;
const slides = slidesFor(post);
const intro = introFor(post);
---

<nav class="photo-menu" aria-label="Photo posts">
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/photos/${p.id}/`} aria-current={p.id === post.id ? 'page' : undefined}>
            {p.data.title}
          </a>
          {p.data.draft && <span class="timeline__draft">draft</span>}
        </li>
      ))
    }
  </ul>
</nav>

<section class="slideshow" aria-roledescription="carousel" aria-label={post.data.title} data-slideshow>
  <div class="slideshow__stage" data-stage>
    <div class="slideshow__track" data-track tabindex="0">
      {
        slides.map((slide, i) => (
          <figure
            class={`slide slide--${slide.kind}`}
            id={`slide-${i + 1}`}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length}`}
            data-caption={slide.kind === 'photo' ? slide.caption : ''}
            data-info={slide.kind === 'photo' ? slide.info : ''}
          >
            {slide.kind === 'photo' ? (
              <Image
                class="slide__image"
                src={slide.src}
                alt={slide.caption.replace(/<[^>]+>/g, '') || post.data.title}
                widths={[640, 1080, 1600, 2400]}
                sizes="90vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            ) : (
              <p class="slide__text" set:html={slide.html} />
            )}
          </figure>
        ))
      }
    </div>
    {
      intro && (
        <div class="slideshow__intro" data-intro aria-hidden="true">
          <div class="slideshow__intro-text" set:html={intro} />
        </div>
      )
    }
  </div>
  <p class="slideshow__line">
    <span class="slideshow__title">{post.data.title}</span>
    <span class="slideshow__caption" data-caption-out set:html={slides[0]?.kind === 'photo' ? slides[0].caption : ''} />
    <span class="slideshow__info" data-info-out>{slides[0]?.kind === 'photo' ? slides[0].info : ''}</span>
    <span class="slideshow__count" data-count>{slides.length ? `1 / ${slides.length}` : ''}</span>
  </p>
</section>

<script>
  for (const show of document.querySelectorAll<HTMLElement>('[data-slideshow]')) {
    const stage = show.querySelector<HTMLElement>('[data-stage]')!;
    const track = show.querySelector<HTMLElement>('[data-track]')!;
    const intro = show.querySelector<HTMLElement>('[data-intro]');
    const slides = [...track.children] as HTMLElement[];
    const captionOut = show.querySelector<HTMLElement>('[data-caption-out]')!;
    const countOut = show.querySelector<HTMLElement>('[data-count]')!;
    const infoOut = show.querySelector<HTMLElement>('[data-info-out]')!;
    let current = 0;

    let arrive: number | undefined;
    const show_ = (i: number, smooth = true) => {
      const next = Math.max(0, Math.min(slides.length - 1, i));
      const moved = next !== current;
      current = next;
      if (moved) update();
      const left = current * track.clientWidth;
      track.scrollTo({ left, behavior: smooth ? 'smooth' : 'instant' });
      // If the smooth scroll doesn't get there (some browsers drop it), jump.
      clearTimeout(arrive);
      arrive = window.setTimeout(() => {
        if (Math.abs(track.scrollLeft - left) > 2) track.scrollTo({ left, behavior: 'instant' });
      }, 500);
    };
    const update = (rememberInAddress = true) => {
      captionOut.innerHTML = slides[current]?.dataset.caption ?? '';
      infoOut.textContent = slides[current]?.dataset.info ?? '';
      countOut.textContent = `${current + 1} / ${slides.length}`;
      // …/#3 links straight to the third photo; the first photo keeps the plain address.
      if (rememberInAddress) {
        const url = current > 0 ? `#${current + 1}` : location.pathname + location.search;
        history.replaceState(null, '', url);
      }
    };

    // The introduction overlay, in front of the first photo.
    let introOpen = false;
    const setIntro = (open: boolean) => {
      if (!intro) return;
      introOpen = open;
      if (open) placeIntro();
      intro.classList.toggle('is-open', open);
      intro.setAttribute('aria-hidden', String(!open));
      // While the intro shows, the photos underneath stay put.
      stage.classList.toggle('is-intro-open', open);
    };

    // The overlay covers exactly the first photo, wherever and however big it is drawn.
    const firstImage = slides[0]?.querySelector('img');
    const placeIntro = () => {
      if (!intro || !firstImage) return;
      // Measured against the track's start, so it is right even mid-scroll.
      const s = stage.getBoundingClientRect();
      const r = firstImage.getBoundingClientRect();
      Object.assign(intro.style, {
        left: `${r.left - s.left + track.scrollLeft}px`,
        top: `${r.top - s.top}px`,
        width: `${r.width}px`,
        height: `${r.height}px`,
      });
    };
    firstImage?.addEventListener('load', placeIntro);
    new ResizeObserver(placeIntro).observe(stage);

    /** One step forward (+1) or back (-1): the intro counts as a step before photo 1. */
    const step = (delta: number) => {
      if (introOpen && delta > 0) return setIntro(false);
      if (intro && !introOpen && current === 0 && delta < 0) return setIntro(true);
      if (!introOpen) show_(current + delta);
    };

    // Start on the photo named in the address (…/#3), or on the intro if there is one.
    const start = Number(location.hash.slice(1)) - 1;
    if (start > 0) {
      current = Math.min(start, slides.length - 1);
      requestAnimationFrame(() => show_(current, false));
    } else {
      setIntro(true);
    }
    update(false);

    // Keep the caption and counter in step however the slide changed (click, key, swipe).
    let settle: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== current || captionOut.dataset.i !== String(i)) {
          current = i;
          captionOut.dataset.i = String(i);
          update();
        }
      }, 80);
    });

    // Right half: next. Left half: previous. Links (in text or the intro) still work.
    const side = (x: number) => {
      const { left, width } = stage.getBoundingClientRect();
      return x - left > width / 2 ? 1 : -1;
    };
    stage.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      step(introOpen ? 1 : side(e.clientX));
    });
    stage.addEventListener('mousemove', (e) => {
      stage.dataset.side = introOpen || side(e.clientX) > 0 ? 'next' : 'prev';
    });

    // Swipes. With the intro showing, a swipe in any direction lifts it away.
    // On the first photo, swiping back (rightwards) brings it down again; other
    // swipes between photos are ordinary scrolling.
    let touch: { x: number; y: number } | null = null;
    stage.addEventListener('touchstart', (e) => {
      touch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (!touch) return;
      const dx = e.changedTouches[0].clientX - touch.x;
      const dy = e.changedTouches[0].clientY - touch.y;
      touch = null;
      if (introOpen && (Math.abs(dx) > 40 || Math.abs(dy) > 40)) step(1);
      else if (intro && current === 0 && track.scrollLeft <= 1 && dx > 50 && Math.abs(dx) > Math.abs(dy)) setIntro(true);
    });

    // Trackpad / mouse-wheel swipes, the same way.
    let wheelTotal = 0;
    let wheelQuietUntil = 0;
    let wheelReset: number | undefined;
    stage.addEventListener('wheel', (e) => {
      const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : 0;
      const onIntroEdge = intro && !introOpen && current === 0 && track.scrollLeft <= 1 && dx < 0;
      if (!introOpen && !onIntroEdge) return; // ordinary scrolling between photos
      e.preventDefault();
      if (Date.now() < wheelQuietUntil) return;
      wheelTotal += introOpen ? Math.abs(e.deltaX) + Math.abs(e.deltaY) : -dx;
      clearTimeout(wheelReset);
      wheelReset = window.setTimeout(() => (wheelTotal = 0), 200);
      if (wheelTotal > 60) {
        wheelTotal = 0;
        wheelQuietUntil = Date.now() + 700; // one swipe, one step
        setIntro(!introOpen);
      }
    }, { passive: false });

    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'ArrowRight') step(1);
      else if (e.key === 'ArrowLeft') step(-1);
      else return;
      e.preventDefault();
    });
    window.addEventListener('resize', () => {
      show_(current, false);
      placeIntro();
    });
  }
</script>
